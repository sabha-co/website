{
  "name": "sabha-docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && rm -f .wrangler/deploy/config.json && node ../../scripts/inline-csp.mjs dist/client --wasm",
    "preview": "wrangler dev",
    "typecheck": "astro check",
    "check": "nimbus-docs check",
    "lint:docs": "nimbus-docs lint",
    "lint:docs:fix": "nimbus-docs lint --fix",
    "deploy": "astro check && pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "catalog:",
    "@cloudflare/nimbus-docs": "0.20.0",
    "@iconify-json/ph": "^1.2.2",
    "@resvg/resvg-js": "^2.6.2",
    "@sabha/theme": "workspace:*",
    "astro": "catalog:",
    "clsx": "^2.1.1",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/language-server": "2.17.3",
    "@emnapi/runtime": "1.11.3",
    "@tailwindcss/vite": "^4.3.3",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "catalog:"
  }
}
