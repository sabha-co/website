---
import { url } from "../utils/url";
import { formatDate } from "../utils/locale";

interface Props {
	// Entries from getEmDashCollection("posts").
	posts: Array<{
		id: string;
		data: { title?: string; excerpt?: string; publishedAt?: Date | null };
		edit: Record<string, Record<string, unknown>>;
	}>;
}

const { posts } = Astro.props;
---

<ul class="post-list">
	{
		posts.map((post) => (
			<li>
				{post.data.publishedAt && (
					<time datetime={post.data.publishedAt.toISOString()}>
						{formatDate(post.data.publishedAt, "long")}
					</time>
				)}
				<h2 {...post.edit.title}>
					<a href={url(`/posts/${post.id}`)}>{post.data.title || "Untitled"}</a>
				</h2>
				{post.data.excerpt && <p {...post.edit.excerpt}>{post.data.excerpt}</p>}
			</li>
		))
	}
</ul>
