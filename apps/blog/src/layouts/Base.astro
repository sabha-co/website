---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { getSiteLocale } from "../utils/locale";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { HOME, url } from "../utils/url";
import "../styles/tokens.css";
import "../styles/site.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle } = resolveBlogSiteIdentity(settingsResult.data);
const fullTitle = title === siteTitle ? title : `${title} — ${siteTitle}`;
const menuItems = menuResult.data?.items ?? [];

// SEO data is passed here and rendered by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

const TRAILING_SLASH = /\/$/;
const currentPath = Astro.url.pathname.replace(TRAILING_SLASH, "") || "/";
const homePath = HOME.replace(TRAILING_SLASH, "") || "/";

/** "page" for the current page, "true" for its parent section (e.g. Posts on a post). */
function navCurrent(href: string): "page" | "true" | undefined {
	let target: URL;
	try {
		target = new URL(href, Astro.url);
	} catch {
		return undefined;
	}
	if (target.origin !== Astro.url.origin || target.hash) return undefined;
	const path = target.pathname.replace(TRAILING_SLASH, "") || "/";
	if (path === currentPath) return "page";
	if (path !== homePath && currentPath.startsWith(`${path}/`)) return "true";
	return undefined;
}

const lang = getSiteLocale() ?? "en";
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${siteTitle} RSS Feed`}
			href={url("/rss.xml")}
		/>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip-link">Skip to content</a>
		<header class="site-header">
			<div class="column">
				<a href={url("/")} class="wordmark">{siteTitle}</a>
				{
					menuItems.length > 0 && (
						<nav class="site-nav" aria-label="Main">
							<ul>
								{menuItems.map((item) => (
									<li>
										<a
											href={item.url}
											aria-current={navCurrent(item.url)}
											target={item.target || undefined}
										>
											{item.label}
										</a>
									</li>
								))}
							</ul>
						</nav>
					)
				}
			</div>
		</header>
		<main id="main" class="column">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="column">
				<span>© {year} <a href="https://sabha.co">Sabha</a></span>
				<span><a href={url("/rss.xml")}>RSS</a> · <a href={url("/search")}>Search</a></span>
			</div>
		</footer>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
