---
import { getTaxonomyTermsWithCacheHint, getEmDashCollection, decodeSlug } from "emdash";
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import Pagination from "../../components/Pagination.astro";
import { url } from "../../utils/url";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("tag", { includeCounts: false });
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.rewrite("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const { entries: posts, cacheHint, nextCursor } = await getEmDashCollection("posts", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}
---

<Base title={term.label} description={term.description}>
	<h1 class="page-title">{term.label}</h1>
	{term.description && <p class="page-lead">{term.description}</p>}
	<h2 class="section-label">Tagged {term.label}</h2>
	{posts.length > 0 ? <PostList posts={posts} /> : <p class="empty">Nothing here yet.</p>}
	<Pagination basePath={url(`/tag/${term.slug}`)} cursor={cursor} nextCursor={nextCursor} />
</Base>
