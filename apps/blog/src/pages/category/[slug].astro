---
import { getTaxonomyTermsWithCacheHint, getEmDashCollection, decodeSlug } from "emdash";
import Base from "../../layouts/Base.astro";
import BlogIndex from "../../components/BlogIndex.astro";
import { url } from "../../utils/url";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("category", { includeCounts: false });
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.rewrite("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const { entries: posts, cacheHint, nextCursor } = await getEmDashCollection("posts", {
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
	limit: 12,
	cursor,
});
if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}
---

<Base title={term.label} description={term.description}>
	<BlogIndex
		posts={posts}
		activeCategory={term.slug}
		basePath={url(`/category/${term.slug}`)}
		cursor={cursor}
		nextCursor={nextCursor}
	/>
</Base>
