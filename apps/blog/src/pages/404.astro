---
import Base from "../layouts/Base.astro";
import { url } from "../utils/url";

Astro.response.status = 404;
---

<Base title="Not found" robots="noindex">
	<h1 class="page-title">Not found</h1>
	<p class="page-lead">There's nothing at this address.</p>
	<form class="search-form" method="get" action={url("/search")} role="search">
		<input type="search" name="q" placeholder="Search the blog" aria-label="Search the blog" />
		<button type="submit">Search</button>
	</form>
	<a href={url("/posts")}>All posts →</a>
</Base>
