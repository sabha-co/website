---
import Marketing from "../layouts/Marketing.astro";
import AgentIcon from "../components/AgentIcon.astro";
import { GITHUB_URL, SIGN_UP_PATH, SITE_URL } from "@sabha/theme/site";
import "../styles/home.css";

const CLOUD_DEPLOY_URL = "https://cloud.sabha.co";

const softwareApplication = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Sabha",
  "description": "The agent-native, open-source alternative to Slack: team chat with one AI agent the whole company shares, room for the bots you bring, and no seat count.",
  "url": SITE_URL,
  "applicationCategory": "CommunicationApplication",
  "operatingSystem": "Web, iOS, Android",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "author": {
    "@type": "Organization",
    "name": "Sabha LLC",
    "url": SITE_URL
  }
};

const reasons = [
  { title: "No per-seat pricing", body: "Add the whole team, contractors and guests included." },
  { title: "Nothing new to learn", body: "Channels, threads and DMs, where your team expects them." },
  { title: "Your model, your key", body: "Use Anthropic, OpenAI, Google or any OpenAI-compatible server, on your own account." },
  { title: "Ask instead of search", body: "The agent finds the answer and shows you where it came from." },
];

const teams = [
  { channel: "sales", person: "Ana", avatar: "ana", ask: "What did we promise Acme about SSO?", answer: "SSO ships in March, SAML first.", page: "Q1 roadmap", by: "Engineering", team: "engineering" },
  { channel: "marketing", person: "Leo", avatar: "leo", ask: "Which customers can we name in the launch post?", answer: "Acme and Northwind said yes. Ask Ana before anyone else.", page: "Customer references", by: "Sales", team: "sales" },
  { channel: "people", person: "Priya", avatar: "priya", ask: "How should the job post describe the company?", answer: "Use the one-liner and keep it plain. No “rockstars”.", page: "Brand voice", by: "Marketing", team: "marketing" },
  { channel: "engineering", person: "Jason", avatar: "jason", ask: "Can I expense a second monitor?", answer: "Yes, up to $300. Keep the receipt.", page: "Equipment policy", by: "People", team: "people" },
];

const connections = ["GitHub", "Linear", "Jira", "Notion", "Sentry"];
---

<Marketing>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(softwareApplication)} />

  {/* Hero */}
  <section class="landing-hero home-hero">
    <div class="landing-inner landing-hero-inner">
      <span class="landing-hero-badge"><span class="home-hero-badge-new">New</span> Built for teams that work with AI agents</span>
      <div class="landing-hero-text">
        <h1>The agent-native, <span class="home-nowrap">open-source</span> alternative to Slack.</h1>
        <p class="landing-hero-sub">Slack treats AI as an add-on. Sabha treats it as a teammate.</p>
      </div>
      <div class="landing-cta-row">
        <a href={SIGN_UP_PATH} class="landing-btn-primary">
          Create a workspace
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
        </a>
        <a href={GITHUB_URL} target="_blank" rel="noopener" class="landing-btn-secondary">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" /></svg>
          Star on GitHub
        </a>
      </div>

      <div class="home-panel home-hero-stage" aria-hidden="true">
        <div class="home-window">
          <div class="home-window-sidebar">
            <div class="home-window-workspace"><span class="home-window-workspace-mark">A</span> Acme</div>
            <span># general</span>
            <span class="is-current"># engineering</span>
            <span># releases</span>
            <span># design</span>
          </div>
          <div class="home-window-main">
            <div class="home-window-title"># engineering</div>
            <div class="home-window-messages">
              <div class="home-msg">
                <span class="home-av home-av--jason"></span>
                <div><div class="home-msg-name">Jason <time>10:31</time></div><p>Push gating fix is merged. Shipping to staging after lunch.</p></div>
              </div>
              <div class="home-msg">
                <span class="home-av home-av--bot">CI</span>
                <div><div class="home-msg-name">Deploy bot <small>APP</small> <time>10:38</time></div><p>main is green · deployed to staging in 2m 14s</p></div>
              </div>
              <div class="home-msg">
                <span class="home-av home-av--maya"></span>
                <div><div class="home-msg-name">Maya <time>10:42</time></div><p>@Sabha Agent is presence still in Redis?</p></div>
              </div>
              <div class="home-msg">
                <AgentIcon />
                <div class="home-msg-body">
                  <div class="home-msg-name">Sabha Agent <time>10:42</time></div>
                  <p>No. It moved to AnyCable's memory broker in October.</p>
                  <div class="home-ask">
                    <div class="home-ask-label">Company brain · needs a yes</div>
                    <p>Presence: AnyCable memory broker, 45s TTL.</p>
                    <div class="home-ask-actions">
                      <span class="home-chip home-chip--ink">Confirm</span>
                      <span class="home-chip">Edit</span>
                      <span class="home-chip home-chip--quiet">Not now</span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="home-msg home-msg--typing">
                <span class="home-typing"><i></i><i></i><i></i></span>
                <p>Sabha Agent is checking the deploy notes…</p>
              </div>
            </div>
            <div class="home-window-composer">Message # engineering</div>
          </div>
        </div>
        <div class="home-card home-hero-page">
          <div class="home-eyebrow">Company brain · Signed</div>
          <div class="home-hero-page-title">Presence and push</div>
          <p>Presence lives in AnyCable's memory broker with a 45s TTL.</p>
          <div class="home-byline"><span class="home-av home-av--sm home-av--maya"></span> Signed by Maya · today</div>
        </div>
      </div>

      <ul class="home-reasons">
        {reasons.map((reason) => (
          <li>
            <h3>{reason.title}</h3>
            <p>{reason.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="landing-divider"></div>

  {/* One agent for the whole company */}
  <section id="features" class="landing-section home-features">
    <div class="landing-inner">
      <div class="landing-section-header">
        <span class="landing-label">FOR EVERY TEAM</span>
        <h2>One agent for the whole company.</h2>
        <p class="landing-section-sub">Sales asks about the roadmap. Engineering asks about the expense policy. The agent answers both from what the other team wrote down.</p>
      </div>

      <div class="home-panel home-teams" aria-hidden="true">
        <div class="home-teams-cards">
          {teams.map((team) => (
            <div class="home-card home-team">
              <div class="home-card-title"># {team.channel}</div>
              <div class="home-team-body">
                <div class="home-msg home-msg--small">
                  <span class={`home-av home-av--sm home-av--${team.avatar}`}></span>
                  <div><div class="home-msg-name">{team.person}</div><p>{team.ask}</p></div>
                </div>
                <div class="home-msg home-msg--small">
                  <AgentIcon size="sm" />
                  <div><div class="home-msg-name">Sabha Agent</div><p>{team.answer}</p></div>
                </div>
                <div class="home-team-source"><span class={`home-dot home-dot--${team.team}`}></span><strong>{team.page}</strong> · by {team.by}</div>
              </div>
            </div>
          ))}
        </div>
        <div class="home-teams-legend">
          <strong>One company brain, kept by every team</strong>
          <span><span class="home-dot home-dot--sales"></span>Sales</span>
          <span><span class="home-dot home-dot--marketing"></span>Marketing</span>
          <span><span class="home-dot home-dot--people"></span>People</span>
          <span><span class="home-dot home-dot--engineering"></span>Engineering</span>
        </div>
      </div>
    </div>
  </section>

  <div class="landing-divider"></div>

  <section class="landing-section">
    <div class="landing-inner home-row">
      <div class="home-panel home-row-panel home-brain" aria-hidden="true">
        <div class="home-card home-page-card">
          <div class="home-page-card-head">
            <span class="home-eyebrow">Company brain · Real-time stack</span>
            <span class="home-pill">Editing</span>
          </div>
          <div class="home-page-card-title">Presence and push</div>
          <p>We run one AnyCable server beside Rails. <del>Presence is stored in Redis.</del> <ins>Presence lives in AnyCable's memory broker with a 45s TTL.</ins></p>
          <div class="home-page-card-foot">
            <span>Maya · editing now</span>
            <span class="home-chip home-chip--ink">Sign and save</span>
          </div>
        </div>
        <div class="home-card home-history">
          <div class="home-eyebrow">Page history</div>
          <div class="home-history-row"><span class="home-av home-av--sm home-av--maya"></span><p><strong>Maya</strong> fixed where presence lives · now</p></div>
          <div class="home-history-row"><AgentIcon size="sm" /><p><strong>Agent</strong> drafted, <strong>Jason</strong> signed · Tue</p></div>
          <div class="home-history-row"><span class="home-av home-av--sm home-av--jason"></span><p><strong>Priya</strong> started the page · Oct 2</p></div>
        </div>
      </div>
      <div class="home-row-text">
        <span class="landing-label">COMPANY BRAIN</span>
        <h2>The company brain, written as a wiki by your team.</h2>
        <ul class="home-points">
          <li>Anyone can write a page or fix one</li>
          <li>The agent drafts, a person confirms</li>
          <li>Every edit has a name and a history</li>
          <li>Fix it once, and it's right for everyone</li>
        </ul>
      </div>
    </div>
  </section>

  <div class="landing-divider"></div>

  <section class="landing-section">
    <div class="landing-inner home-row home-row--reverse">
      <div class="home-panel home-row-panel" aria-hidden="true">
        <div class="home-card home-answer">
          <div class="home-msg">
            <span class="home-av home-av--priya"></span>
            <div><div class="home-msg-name">Priya <time>· joined Monday</time></div><p>@Sabha Agent why are we on AnyCable and not ActionCable?</p></div>
          </div>
          <div class="home-msg">
            <AgentIcon />
            <div class="home-msg-body">
              <div class="home-msg-name">Sabha Agent</div>
              <p>The team chose AnyCable in July so presence and push stay fast with one small server. David signed the decision.</p>
              <div class="home-sources">
                <span class="home-source">↗ Real-time stack</span>
                <span class="home-source">↗ Decision · July 14</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="home-row-text">
        <span class="landing-label">ANSWERS WITH SOURCES</span>
        <h2>Every answer shows where it came from.</h2>
        <ul class="home-points">
          <li>@mention the agent in any channel or DM</li>
          <li>It links the pages it used</li>
          <li>One click opens the source, ready to fix</li>
        </ul>
      </div>
    </div>
  </section>

  <div class="landing-divider"></div>

  <section class="landing-section">
    <div class="landing-inner home-row">
      <div class="home-panel home-row-panel home-connections" aria-hidden="true">
        <div class="home-card home-support">
          <div class="home-card-title"># support</div>
          <div class="home-support-body">
            <div class="home-msg">
              <span class="home-av home-av--maya"></span>
              <div><div class="home-msg-name">Maya</div><p><strong>@Sabha Agent</strong> where are we on the iOS double push?</p></div>
            </div>
            <div class="home-msg">
              <AgentIcon />
              <div class="home-msg-body">
                <div class="home-msg-name">Sabha Agent</div>
                <p>Fixed in PR #482, merged yesterday. OPS-412 is Done, and Sentry has seen no new events since 14:00.</p>
                <div class="home-checked">
                  <span>Checked over MCP</span>
                  <span class="home-tool"><span class="home-logo home-logo--github"></span>GitHub</span>
                  <span class="home-tool"><span class="home-logo home-logo--linear"></span>Linear</span>
                  <span class="home-tool"><span class="home-logo home-logo--sentry"></span>Sentry</span>
                </div>
                <div class="home-confirm">
                  <p>Resolve the Sentry issue?</p>
                  <span class="home-chip home-chip--ink">Confirm</span>
                  <span class="home-chip">Not now</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="home-tiles">
          {connections.map((name) => (
            <span class="home-tile"><span class={`home-logo home-logo--${name.toLowerCase()}`}></span>{name}</span>
          ))}
          <span class="home-tile home-tile--more">+ more</span>
        </div>
      </div>
      <div class="home-row-text">
        <span class="landing-label">CONNECTIONS OVER MCP</span>
        <h2>It works in the tools you already use.</h2>
        <ul class="home-points">
          <li>GitHub, Linear, Jira, Notion, Sentry and more, through each one's own MCP server</li>
          <li>One shared account for the agent, set up once</li>
          <li>Or your own, used only when you ask</li>
          <li>Reads at once; changes wait for Confirm</li>
        </ul>
      </div>
    </div>
  </section>

  <div class="landing-divider"></div>

  <section class="landing-section">
    <div class="landing-inner home-row home-row--reverse">
      <div class="home-panel home-row-panel" aria-hidden="true">
        <div class="home-card home-app-card">
          <div class="home-app-card-head">
            <span class="home-av home-av--jira"></span>
            <strong>Jira</strong>
            <span class="home-tag">App</span>
            <time>10:42</time>
          </div>
          <div class="home-app-card-issue">
            <strong>OPS-412 · Push arrives twice on iOS</strong>
            <div class="home-app-card-fields">
              <span>Priority <b>High</b></span>
              <span>Assignee <b>Maya</b></span>
            </div>
            <div class="home-app-card-actions">
              <span class="home-chip">Take it</span>
              <span class="home-chip">Open in Jira</span>
            </div>
          </div>
        </div>
        <div class="home-tiles">
          {["Notion", "Linear", "GitHub", "Sentry"].map((name) => (
            <span class="home-tile"><span class={`home-logo home-logo--${name.toLowerCase()}`}></span>{name}</span>
          ))}
          <span class="home-tile home-tile--more">+ more</span>
        </div>
      </div>
      <div class="home-row-text">
        <span class="landing-label">SPEAKS SLACK</span>
        <h2>Bring the apps you use with Slack.</h2>
        <ul class="home-points">
          <li>Notion, Jira, Linear, GitHub and more</li>
          <li>Messages, commands and webhooks, Slack-shaped</li>
          <li>A Slack app moves over with small changes</li>
        </ul>
      </div>
    </div>
  </section>

  <div class="landing-divider"></div>

  <section class="landing-section">
    <div class="landing-inner home-row">
      <div class="home-panel home-row-panel" aria-hidden="true">
        <div class="home-card home-bots">
          <div class="home-eyebrow">Bots in this team</div>
          <div class="home-bot">
            <span class="home-av home-av--lg home-av--openclaw"></span>
            <div><strong>OpenClaw</strong><span>Jason's bot · reads # engineering</span></div>
            <em>● Connected</em>
          </div>
          <div class="home-bot">
            <span class="home-av home-av--lg home-av--hermes"></span>
            <div><strong>Hermes</strong><span>Ops bot · answers in # support</span></div>
            <em>● Connected</em>
          </div>
          <div class="home-bot">
            <span class="home-av home-av--lg home-av--empty"></span>
            <div><strong>Your own bot</strong><span>Through the API · any channel it's invited to</span></div>
            <em class="home-bot-add">+ Add</em>
          </div>
        </div>
      </div>
      <div class="home-row-text">
        <span class="landing-label">BRING YOUR OWN BOTS</span>
        <h2>Bring the AI bots you already run.</h2>
        <ul class="home-points">
          <li>Ready-made for <a href="/openclaw" class="landing-link">OpenClaw</a> and Hermes</li>
          <li>An open API for any bot you host</li>
          <li>They read, reply, thread and react like members</li>
          <li>Each gets its own key and permissions</li>
        </ul>
      </div>
    </div>
  </section>

  <div class="landing-divider"></div>

  {/* Feel at home */}
  <section class="landing-section">
    <div class="landing-inner">
      <div class="landing-section-header">
        <span class="landing-label">FEEL AT HOME</span>
        <h2 class="home-wide-title">Everything you use in Slack, minus the sprawl.</h2>
        <p class="landing-section-sub">Your team switches on Monday and nobody needs a training session.</p>
      </div>

      <ul class="home-homes">
        <li>
          <div class="home-panel home-home-stage" aria-hidden="true">
            <div class="home-card home-channels">
              <span># general</span>
              <span class="is-current"># engineering <b>3</b></span>
              <span class="home-channels-thread">↳ Push gating · 4 replies</span>
              <span>▤ ideas</span>
            </div>
          </div>
          <h3>Channels and threads</h3>
          <p>Open, private and forum channels. Threads that stay out of the way.</p>
        </li>
        <li>
          <div class="home-panel home-home-stage" aria-hidden="true">
            <div class="home-card home-dm">
              <div class="home-card-title"><span class="home-av home-av--xs home-av--priya"></span> Priya</div>
              <div class="home-dm-body">
                <span class="home-bubble">Got five minutes for the onboarding copy?</span>
                <span class="home-bubble home-bubble--mine">Sure, send it over.</span>
              </div>
            </div>
          </div>
          <h3>Direct messages</h3>
          <p>One-to-one or a small group, for the things that don't need a channel.</p>
        </li>
        <li>
          <div class="home-panel home-home-stage" aria-hidden="true">
            <div class="home-card home-activity">
              <div class="home-activity-head"><strong>Activity</strong> <b>2</b></div>
              <div class="home-activity-row is-unread">
                <span class="home-av home-av--sm home-av--maya"></span>
                <div><small><strong>Maya</strong> mentioned you · # engineering</small><p>Can you check the push fix?</p></div>
              </div>
              <div class="home-activity-row is-unread">
                <span class="home-av home-av--sm home-av--jason"></span>
                <div><small><strong>Jason</strong> replied · Push gating</small><p>Merged. Shipping after lunch.</p></div>
              </div>
              <div class="home-activity-row">
                <span class="home-av home-av--sm home-av--priya"></span>
                <div><small><strong>Priya</strong> · Direct message</small><p>Thanks, that reads much better.</p></div>
              </div>
            </div>
          </div>
          <h3>Activity inbox</h3>
          <p>Mentions, replies and DMs in one list. Read and reply without leaving it.</p>
        </li>
        <li>
          <div class="home-panel home-home-stage" aria-hidden="true">
            <div class="home-card home-reactions">
              <div class="home-msg home-msg--small">
                <span class="home-av home-av--jason"></span>
                <div><div class="home-msg-name">Jason <time>10:42</time></div><p>v2.4 is out. Release notes are in #releases.</p></div>
              </div>
              <div class="home-reactions-row">
                <span class="home-reaction is-mine">🎉 6</span>
                <span class="home-reaction">🙌 3</span>
                <span class="home-reaction">👀 2</span>
              </div>
            </div>
          </div>
          <h3>Reactions and emoji</h3>
          <p>The small things your hands already know, in the same places.</p>
        </li>
        <li>
          <div class="home-panel home-home-stage" aria-hidden="true">
            <div class="home-card home-push">
              <AgentIcon size="lg" />
              <div>
                <div class="home-push-head"><strong>Maya in # engineering</strong><time>now</time></div>
                <p>@Jason can you look at the push fix before lunch?</p>
              </div>
            </div>
          </div>
          <h3>Desktop and phone</h3>
          <p>On your laptop or your phone, with push that stays quiet when you're already looking.</p>
        </li>
        <li>
          <div class="home-panel home-home-stage" aria-hidden="true">
            <div class="home-card home-import">
              <div class="home-import-head"><code>acme-slack-export.zip</code><b>72%</b></div>
              <div class="home-import-bar"><i></i></div>
              <p>38 channels · 41,206 messages · 1,930 files</p>
            </div>
          </div>
          <h3>Import from Slack</h3>
          <p>Bring your export. Channels and history arrive as they were.</p>
        </li>
      </ul>
    </div>
  </section>

  {/* Try it first */}
  <section id="pricing" class="landing-section home-try">
    <div class="landing-inner">
      <div class="landing-section-header">
        <span class="landing-label">TRY IT FIRST</span>
        <h2 class="home-wide-title">Start on sabha.co. Decide where it lives later.</h2>
        <p class="landing-section-sub">Sign up, bring your team and use it for real. Nothing to install.</p>
      </div>

      <div class="home-try-cards">
        <div class="home-try-start">
          <div>
            <span class="home-try-step">1 · Try it</span>
            <h3>Try it with your team on sabha.co.</h3>
            <p>Channels, threads, the company brain and the agent, ready in a minute. Invite the people you work with and run a real week on it.</p>
          </div>
          <div class="home-try-start-action">
            <a href={SIGN_UP_PATH} class="landing-btn-primary">
              Create a workspace
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
            </a>
            <small>The agent comes with a starter model key.</small>
          </div>
        </div>

        <div class="home-try-choose">
          <span class="home-try-step">2 · Then choose where it lives</span>
          <h3>Happy with it? Keep it, or take it with you.</h3>
          <dl class="home-try-options">
            <div>
              <dt>Stay on sabha.co</dt>
              <dd>Nothing to run. We keep it up to date.</dd>
              <dd class="home-try-action">Do nothing</dd>
            </div>
            <div>
