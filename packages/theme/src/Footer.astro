---
import Wordmark from "./Wordmark.astro";
import { footerColumns } from "./site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-top">
      <div class="site-footer-brand">
        <Wordmark size="small" />
        <p>Community chat. Familiar, small, yours.</p>
      </div>

      <div class="site-footer-cols">
        {footerColumns.map((column) => (
          <div class="site-footer-col">
            <h2>{column.heading}</h2>
            {column.links.map((link) => (
              <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener" : undefined}>
                {link.label}
              </a>
            ))}
          </div>
        ))}
      </div>
    </div>

    <hr />

    <div class="site-footer-bottom">
      <span>&copy; {year} Sabha LLC. All rights reserved.</span>
      <span>MIT licensed.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 3.75rem 0;
    background: var(--sabha-color-bg);
    color: var(--sabha-color-text);
    font-family: var(--font-body);
    line-height: 1.6;
  }

  .site-footer-inner {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    max-width: var(--site-max);
    margin: 0 auto;
    padding: 0 var(--site-pad);
    box-sizing: content-box;
  }

  .site-footer-top {
    display: flex;
    justify-content: space-between;
    gap: 2.5rem;
  }

  .site-footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    width: 18.75rem;
  }

  .site-footer-brand p {
    margin: 0;
    font-size: var(--font-size-sm);
    line-height: var(--leading-normal);
    color: var(--sabha-color-muted);
  }

  .site-footer-cols {
    display: flex;
    gap: 5rem;
  }

  .site-footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .site-footer-col h2 {
    margin: 0;
    font-size: var(--font-size-xs);
    font-weight: 600;
  }

  .site-footer-col a {
    font-size: var(--font-size-xs);
    color: var(--sabha-color-muted);
    text-decoration: none;
    transition: color var(--ease);
  }

  .site-footer-col a:hover {
    color: var(--sabha-color-text);
  }

  .site-footer-col a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  hr {
    height: 1px;
    margin: 0;
    border: 0;
    background: var(--sabha-color-border);
  }

  .site-footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.75rem;
    color: var(--sabha-color-muted);
  }

  @media (max-width: 1024px) {
    .site-footer-cols {
      gap: 2.5rem;
    }
  }

  @media (max-width: 834px) {
    .site-footer {
      padding: 2.5rem 0;
    }

    .site-footer-top,
    .site-footer-bottom {
      flex-direction: column;
    }
  }
</style>
